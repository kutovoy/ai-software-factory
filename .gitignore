# OS / editor
.DS_Store
*.swp

# Node / Bun
node_modules/
.bun/
dist/
.next/
out/
*.tsbuildinfo

# Playwright artifacts
playwright-report/
test-results/
blob-report/
# Saved admin session used by the E2E suite (never commit a live cookie)
apps/web/e2e/.auth/

# Python
__pycache__/
*.pyc
.venv/
tools/yt/.venv/

# Factory definition caches
factories/*/.factory-cache/

# Env & secrets
.env
.env.*
!.env.example
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12
secrets/

# Local forge bind data (named volumes are used by default)
forgejo-data/

# Logs, coverage, editor state
*.log
coverage/
.idea/
.vscode/

# Media & run artifacts (keep transcripts, frames, manifests — not raw video/audio)
*.mp4
*.mkv
*.webm
*.m4a
*.wav
# Only the run-artifact directory at the repo root; `apps/web/src/app/runs/**` and
# `apps/web/src/app/api/runs/**` are source files and must stay tracked.
/runs/
.opencode/state/
