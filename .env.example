# Copy to `.env` (git-ignored) and adjust. `docker compose` reads `.env` automatically.

# --- Persistence -------------------------------------------------------------
# Host-side port is 5433 to avoid clashing with a local Postgres.
DATABASE_URL=postgres://factory:factory@localhost:5433/factory

# --- Orchestration -----------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=factory-runs

# --- Definitions (git-backed, ADR-003) ---------------------------------------
FACTORY_ROOT=./factories
# Git root that contains FACTORY_ROOT; runs pin `definitionCommit` from here.
REPO_ROOT=.
RUNS_DIR=./runs
DEFAULT_FACTORY=example

# --- Inference ---------------------------------------------------------------
# Upstream OpenAI-compatible endpoint. The API/worker hold the real key; the runner
# only ever gets PROXY_PUBLIC_URL + a per-run token (ADR-011).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Model references (ADR-028): definitions declare env:FACTORY_*, so the concrete model
# name is configuration, not a value baked into git. Point these at the models your
# provider (e.g. a LiteLLM proxy) actually serves.
FACTORY_MODEL=best_llm
FACTORY_SMALL_MODEL=best_llm
FACTORY_REVIEW_MODEL=best_llm
# URL the sandbox uses to reach the proxy (inside Docker Desktop this is the host).
PROXY_PUBLIC_URL=http://host.docker.internal:8080/v1

# Dev/smoke only. With the stub enabled the proxy talks to a canned local upstream, so
# the full path works with zero credentials and zero network.
PROXY_STUB_UPSTREAM=0
# Dev/smoke only: expose POST /runs/:id/proxy-token so a test can exercise the proxy.
EXPOSE_RUN_TOKEN=0

# --- Console auth (Phase 6b, ADR-035) ----------------------------------------
# Compose runs with auth on. Set AUTH_REQUIRED=0 for the implicit local user
# (unit/integration tests and quick local development).
AUTH_REQUIRED=1
# Bootstrap admin, created only when the users table is empty. These are LOCAL
# DEVELOPMENT credentials: change both and set AUTH_COOKIE_SECURE=1 (HTTPS)
# before exposing the console.
FACTORY_ADMIN_EMAIL=admin@factory.local
FACTORY_ADMIN_PASSWORD=factory-admin
AUTH_COOKIE_SECURE=0
# Personal forge organization created on first login: <prefix><username>.
FORGEJO_ORG_PREFIX=u-

# --- Runner ------------------------------------------------------------------
# docker = real sandbox per run (needs Docker); local = host process fallback.
RUNNER_BACKEND=docker
# How long a permission request may wait before it is auto-denied (ADR-013 SLA timer).
PERMISSION_TIMEOUT_MS=1800000
# Worker concurrency. A *streaming* run holds one activity slot; a run waiting for a human
# permission holds none (the wait lives in workflow state). Code defaults: 100 / 100.
WORKER_MAX_CONCURRENT_ACTIVITY_TASKS=8
WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=8
# Orphan sandbox reaper: reconciles label-managed runner containers with runs + Temporal.
# Set RUNNER_REAPER=0 to disable; use RUNNER_REAPER_DRY_RUN=1 for a first rollout.
RUNNER_REAPER=1
RUNNER_REAPER_INTERVAL_MS=300000
RUNNER_REAPER_DRY_RUN=0
RUNNER_REAPER_MAX_AGE_MS=21600000
RUNNER_REAPER_GRACE_MS=300000

# --- Retention / GC ----------------------------------------------------------
# Terminal runs older than RETENTION_DAYS, beyond the newest RETENTION_KEEP_RUNS per
# factory, are removed with their rows, run directory, artifact blobs and terminal canary
# trees. The worker sweeps on RETENTION_SWEEP_INTERVAL_MS; the Runs page also exposes a
# manual GC. Set RETENTION_ENABLED=0 to disable; RETENTION_DRY_RUN=1 for a first pass.
RETENTION_ENABLED=1
RETENTION_DAYS=30
RETENTION_KEEP_RUNS=100
RETENTION_SWEEP_INTERVAL_MS=21600000
RETENTION_DRY_RUN=0

# --- Remote runners (Linux MVP) ----------------------------------------------
# Enable the central control plane. A run uses `runner: remote` (or a definition whose
# runner name contains "remote"). The remote host runs an agent; it never gets Temporal or
# Postgres credentials. Deploy behind TLS: the agent token is a bearer credential in the
# MVP, with mTLS certificate fingerprinting reserved for the follow-up.
REMOTE_RUNNER=0
REMOTE_RUNNER_PLATFORM=linux
REMOTE_RUNNER_POOL=default
# Clone URL a remote agent can reach (the central checkout path is not visible to it).
RUNNER_REPO_URL=
# How long an activity waits for one agent command result.
REMOTE_COMMAND_TIMEOUT_MS=120000
# Lease TTL for a remote sandbox; a retried lease re-attaches by runnerId.
REMOTE_LEASE_TTL_MS=900000
# Worker cadence for heartbeat-age alerts and lease expiry.
REMOTE_ALERT_INTERVAL_MS=30000
# Agent-side defaults (used by `packages/runners/src/agent.ts`).
RUNNER_AGENT_VERSION=0.0.0-dev
RUNNER_HEARTBEAT_INTERVAL_MS=15000
RUNNER_COMMAND_POLL_TIMEOUT_MS=25000
# Upload collected artifacts to the control plane's artifact store (ADR-047). The agent asks
# for short-lived presigned PUT URLs; set RUNNER_ARTIFACT_UPLOAD=0 to keep metadata only.
RUNNER_ARTIFACT_UPLOAD=1

# --- Artifact store (RustFS, ADR-047) -----------------------------------------
# S3-compatible object storage for run artifacts. RustFS is the default Apache-2.0 store;
# it replaces the archived AGPLv3 community object store. The store is disabled unless
# ARTIFACT_STORE=s3 and endpoint/bucket/credentials are all set. These are local-compose
# development defaults; override them for production and never copy the RustFS credentials
# to a runner host.
ARTIFACT_STORE=s3
# Public endpoint agents use for presigned URLs. It must be reachable from runner hosts:
# a remote host cannot use localhost. Compose default: http://host.docker.internal:9000
# (the generated Linux agent container joins the host gateway); use http://localhost:9000
# for a macOS native agent on the same machine, or a public TLS URL for remote hosts.
S3_ENDPOINT=http://host.docker.internal:9000
# Browser-facing endpoint used for presigned downloads. Defaults to S3_ENDPOINT. When a
# Linux agent uploads via host.docker.internal, set this to http://localhost:9000 so the
# console's redirect works from the host.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Server-side endpoint (bucket init, optional HEAD verification). Defaults to S3_ENDPOINT.
S3_INTERNAL_ENDPOINT=http://rustfs:9000
S3_BUCKET=factory-artifacts
# RustFS root credentials / S3 access key pair. Never put these on a runner host: agents only
# receive short-lived presigned URLs signed by the API.
S3_ACCESS_KEY=factory-rustfs
S3_SECRET_KEY=factory-rustfs-secret
S3_REGION=us-east-1
# RustFS path-style addressing (`http://host:9000/bucket/key`); set 0 for virtual-host style.
S3_FORCE_PATH_STYLE=1
# Presigned grant lifetime (1–604800 seconds).
S3_PRESIGN_EXPIRY_SECONDS=900
# Per-artifact upload cap; larger artifacts are refused before a grant is issued.
S3_MAX_ARTIFACT_BYTES=52428800

# --- Factory loop (Phase 3a) --------------------------------------------------
# SLA for an undecided stage gate. The wait is workflow-level (no activity slot); the SLA
# only decides the fallback: auto-reject lights-on, auto-approve only when the autonomy
# policy and benchmark gate allow it.
GATE_SLA_MS=86400000
# request_changes loop limit before the item escalates to a human.
FACTORY_LOOP_LIMIT=3
# FactoryWorkflow calls continueAsNew after this many completed stages (bounded history).
FACTORY_CONTINUE_AFTER_STAGES=10

# --- Benchmarks (Phase 4b, ADR-018/ADR-019) ----------------------------------
# Compose runs hermetic trials on the fake harness + fake forge (no network/credentials).
# In production leave BENCHMARK_HARNESS/RUNNER unset to use the factory defaults.
BENCHMARK_HARNESS=fake
BENCHMARK_RUNNER=fake
# Max concurrent child runs per benchmark; trials are fanned out in deterministic batches.
BENCHMARK_CONCURRENCY=2
# Fallback per-run cost when a factory has no comparable terminal runs.
BENCHMARK_DEFAULT_RUN_COST_USD=0.5
# Estimates above this require an explicit `confirm: true`.
BENCHMARK_CONFIRM_THRESHOLD_USD=5
# Default hard cap; remaining trials are skipped with `budget_exhausted`.
BENCHMARK_MAX_COST_USD=25
# Calibrated pass rate required to attest a factory version for autonomy.
BENCHMARK_PASS_THRESHOLD=0.8

# --- Self-improvement (Phase 5) ----------------------------------------------
# Minimum distinct scored runs before the observer may propose (production default 3;
# compose lowers it to 1 so the smoke corpus is eligible).
IMPROVEMENT_MIN_SCORED_RUNS=3
# Scored-corpus window for one improvement run, in days.
IMPROVEMENT_WINDOW_DAYS=30
# Cap on proposals kept after dedupe, ranked by impact.
IMPROVEMENT_MAX_PROPOSALS=5
# Owner of the git repo that hosts factory definitions (fake forge in CI).
DEFINITION_REPO_OWNER=factory

# --- GitHub forge, merge queue and webhooks (Phase 3b) -----------------------
# Token secret *reference*: the value is read from this env name at run time and never
# appears in definitions, events or logs.
GITHUB_TOKEN=
# HMAC key GitHub signs deliveries with (secret reference: GITHUB_WEBHOOK_SECRET).
GITHUB_WEBHOOK_SECRET=smoke-webhook-secret
# Public API origin; the console renders <origin>/api/v1/webhooks/github as the webhook URL.
WEBHOOK_PUBLIC_URL=http://localhost:8080
# Hard cap on a webhook body; larger deliveries are rejected with payload_too_large.
WEBHOOK_MAX_BYTES=1000000
# `1` makes every GitHub mutation a no-op that reports the intended action (demos).
GITHUB_DRY_RUN=0
# Forge API base. `https://api.github.com` is the GitHub dialect; anything else (e.g. the
# local forge, `http://forgejo:3000/api/v1`) is served by the Gitea-compatible dialect, which
# the same `CodeForge` client adapts behind the contract (spec `code-forge`). `scripts/
# forgejo-bootstrap.sh` sets this and the token for you.
GITHUB_API_BASE_URL=https://api.github.com
# Optional override: `fake` (default for factories without a configured connection) or
# `github`. Unset means "the factory's stored integration decides".
# CODE_FORGE=fake
# Merge queue: pull requests per batch (ADR-022), stack-gate timeout and poll interval.
MERGE_BATCH_SIZE=2
MERGE_CHECKS_TIMEOUT_MS=600000
MERGE_CHECKS_POLL_MS=2000
MERGE_MAX_BATCHES=25
MERGE_IDLE_INTERVAL_MS=30000
MERGE_IDLE_CYCLES=2

# --- Local forge (Forgejo, spec `forge`, ADR-032) -----------------------------
# Enabled by default: `docker compose up -d` starts it and the console serves it at
# http://localhost:3000/extras/forgejo/. To opt out:
#   FORGEJO_ENABLED=0 docker compose -f compose.yaml -f compose.no-forgejo.yaml up -d
FORGEJO_ENABLED=1
# Fallback identity the console proxy asserts when auth is off. With auth on, the proxy
# asserts the signed-in user's username instead. The admin is created by
# scripts/forgejo-bootstrap.sh; its password is generated and stored here.
FORGEJO_ADMIN_USER=factory
# FORGEJO_ADMIN_PASSWORD is written by the bootstrap script on first run.
# Public URL of the forge (used by the bootstrap and shown in the console); the forge is
# served through the console origin, never on its own host port.
FORGEJO_PUBLIC_URL=http://localhost:3000/extras/forgejo
# Server-side target the console proxy forwards to (inside compose).
FORGEJO_URL=http://forgejo:3000

# --- API ---------------------------------------------------------------------
API_PORT=8080
FACTORY_VERSION=0.0.0-dev

# --- Web console (apps/web) --------------------------------------------------
# Server-side base URL the console uses to reach the API (inside compose: http://api:8080).
API_BASE_URL=http://localhost:8080
# Public API origin, exposed to the browser bundle for diagnostics; the browser itself
# talks to same-origin /api/* route handlers (no CORS, SSE is proxied un-buffered).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Host port for the console (`docker compose` maps 3000:3000).
WEB_PORT=3000
# E2E origin for Playwright (`cd apps/web && bunx playwright test`).
E2E_BASE_URL=http://localhost:3000
