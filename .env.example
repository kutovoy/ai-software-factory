# Copy to `.env` (git-ignored) and adjust. `docker compose` reads `.env` automatically.

# --- Persistence -------------------------------------------------------------
# Host-side port is 5433 to avoid clashing with a local Postgres.
DATABASE_URL=postgres://factory:factory@localhost:5433/factory

# --- Orchestration -----------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=factory-runs

# --- Definitions (git-backed, ADR-003) ---------------------------------------
FACTORY_ROOT=./factories
# Git root that contains FACTORY_ROOT; runs pin `definitionCommit` from here.
REPO_ROOT=.
RUNS_DIR=./runs
DEFAULT_FACTORY=example

# --- Inference ---------------------------------------------------------------
# Upstream OpenAI-compatible endpoint. The API/worker hold the real key; the runner
# only ever gets PROXY_PUBLIC_URL + a per-run token (ADR-011).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Model references (ADR-028): definitions declare env:FACTORY_*, so the concrete model
# name is configuration, not a value baked into git. Point these at the models your
# provider (e.g. a LiteLLM proxy) actually serves.
FACTORY_MODEL=best_llm
FACTORY_SMALL_MODEL=best_llm
FACTORY_REVIEW_MODEL=best_llm
# URL the sandbox uses to reach the proxy (inside Docker Desktop this is the host).
PROXY_PUBLIC_URL=http://host.docker.internal:8080/v1

# Dev/smoke only. With the stub enabled the proxy talks to a canned local upstream, so
# the full path works with zero credentials and zero network.
PROXY_STUB_UPSTREAM=0
# Dev/smoke only: expose POST /runs/:id/proxy-token so a test can exercise the proxy.
EXPOSE_RUN_TOKEN=0

# --- Runner ------------------------------------------------------------------
# docker = real sandbox per run (needs Docker); local = host process fallback.
RUNNER_BACKEND=docker
# How long a permission request may wait before it is auto-denied (ADR-013 SLA timer).
PERMISSION_TIMEOUT_MS=1800000
# Worker concurrency. A *streaming* run holds one activity slot; a run waiting for a human
# permission holds none (the wait lives in workflow state). Code defaults: 100 / 100.
WORKER_MAX_CONCURRENT_ACTIVITY_TASKS=8
WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=8

# --- Factory loop (Phase 3a) --------------------------------------------------
# SLA for an undecided stage gate. The wait is workflow-level (no activity slot); the SLA
# only decides the fallback: auto-reject lights-on, auto-approve only when the autonomy
# policy and benchmark gate allow it.
GATE_SLA_MS=86400000
# request_changes loop limit before the item escalates to a human.
FACTORY_LOOP_LIMIT=3
# FactoryWorkflow calls continueAsNew after this many completed stages (bounded history).
FACTORY_CONTINUE_AFTER_STAGES=10

# --- Benchmarks (Phase 4b, ADR-018/ADR-019) ----------------------------------
# Compose runs hermetic trials on the fake harness + fake forge (no network/credentials).
# In production leave BENCHMARK_HARNESS/RUNNER unset to use the factory defaults.
BENCHMARK_HARNESS=fake
BENCHMARK_RUNNER=fake
# Max concurrent child runs per benchmark; trials are fanned out in deterministic batches.
BENCHMARK_CONCURRENCY=2
# Fallback per-run cost when a factory has no comparable terminal runs.
BENCHMARK_DEFAULT_RUN_COST_USD=0.5
# Estimates above this require an explicit `confirm: true`.
BENCHMARK_CONFIRM_THRESHOLD_USD=5
# Default hard cap; remaining trials are skipped with `budget_exhausted`.
BENCHMARK_MAX_COST_USD=25
# Calibrated pass rate required to attest a factory version for autonomy.
BENCHMARK_PASS_THRESHOLD=0.8

# --- Self-improvement (Phase 5) ----------------------------------------------
# Minimum distinct scored runs before the observer may propose (production default 3;
# compose lowers it to 1 so the smoke corpus is eligible).
IMPROVEMENT_MIN_SCORED_RUNS=3
# Scored-corpus window for one improvement run, in days.
IMPROVEMENT_WINDOW_DAYS=30
# Cap on proposals kept after dedupe, ranked by impact.
IMPROVEMENT_MAX_PROPOSALS=5
# Owner of the git repo that hosts factory definitions (fake forge in CI).
DEFINITION_REPO_OWNER=factory

# --- GitHub forge, merge queue and webhooks (Phase 3b) -----------------------
# Token secret *reference*: the value is read from this env name at run time and never
# appears in definitions, events or logs.
GITHUB_TOKEN=
# HMAC key GitHub signs deliveries with (secret reference: GITHUB_WEBHOOK_SECRET).
GITHUB_WEBHOOK_SECRET=smoke-webhook-secret
# Public API origin; the console renders <origin>/api/v1/webhooks/github as the webhook URL.
WEBHOOK_PUBLIC_URL=http://localhost:8080
# Hard cap on a webhook body; larger deliveries are rejected with payload_too_large.
WEBHOOK_MAX_BYTES=1000000
# `1` makes every GitHub mutation a no-op that reports the intended action (demos).
GITHUB_DRY_RUN=0
# GitHub REST base (a stub in tests/dry-run demos).
GITHUB_API_BASE_URL=https://api.github.com
# Merge queue: pull requests per batch (ADR-022), stack-gate timeout and poll interval.
MERGE_BATCH_SIZE=2
MERGE_CHECKS_TIMEOUT_MS=600000
MERGE_CHECKS_POLL_MS=2000
MERGE_MAX_BATCHES=25
MERGE_IDLE_INTERVAL_MS=30000
MERGE_IDLE_CYCLES=2

# --- API ---------------------------------------------------------------------
API_PORT=8080
FACTORY_VERSION=0.0.0-dev

# --- Web console (apps/web) --------------------------------------------------
# Server-side base URL the console uses to reach the API (inside compose: http://api:8080).
API_BASE_URL=http://localhost:8080
# Public API origin, exposed to the browser bundle for diagnostics; the browser itself
# talks to same-origin /api/* route handlers (no CORS, SSE is proxied un-buffered).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Host port for the console (`docker compose` maps 3000:3000).
WEB_PORT=3000
# E2E origin for Playwright (`cd apps/web && bunx playwright test`).
E2E_BASE_URL=http://localhost:3000
